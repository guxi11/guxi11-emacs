# Per-machine config for claude-tmux-persist. Copy to `.env` and edit.
# `.env` is gitignored; this template is checked in.

# Path to the `claude` (or compatible) CLI on this machine.
CLAUDE_TMUX_BIN=/Users/you/.local/bin/claude

# Optional: tmux -L socket name for the dedicated server (default: claude-emacs)
# CLAUDE_TMUX_SOCKET=claude-emacs
